---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SeasonTable from '../components/SeasonTable.astro';
import Enquiry from '../components/Enquiry.astro';
import Faq from '../components/Faq.astro';
import { ROUTES, type Lang } from '../i18n/routes';
import { fmtEUR } from '../i18n/ui';
import { SEASONS, RULES, FROM_PRICE } from '../data/rates';
import { PROPERTY } from '../data/property';
import { FAQ } from '../data/faq';
import { breadcrumbJsonLd, faqJsonLd } from '../data/jsonld';

interface Props { lang: Lang }
const { lang } = Astro.props;
const de = lang === 'de';
const eur = (n: number) => fmtEUR(n, lang);
const eur2 = (n: number) => new Intl.NumberFormat(de ? 'de-AT' : 'en-GB', { style: 'currency', currency: 'EUR', minimumFractionDigits: 2 }).format(n);
const pp = (n: number) => eur(Math.round(n / 10));
const order = ['low', 'shoulder', 'summer', 'winter', 'peak', 'festive'] as const;
const host = PROPERTY.host;

const C = de ? {
  title: 'Preise & Anfrage – Bauernhaus für 10 Gäste im Alpbachtal | Untermoos',
  description: `Das ganze Bauernhaus für bis zu 10 Gäste ab ${eur(FROM_PRICE)} pro Nacht – Endreinigung, Bettwäsche, Energie, Brennholz und Alpbachtal Card inklusive. Saisonpreise, Konditionen und Richtpreis sofort.`,
  eyebrow: 'Preise & Anfrage', heroTitle: 'Das ganze Haus. Ein klarer Preis.',
  leadWinter: `Ab ${eur(FROM_PRICE)} pro Nacht für bis zu zehn Gäste. Endreinigung, Bettwäsche, Energie, Brennholz für den Kachelofen und die Alpbachtal Card sind inklusive.`,
  leadSummer: `Ab ${eur(FROM_PRICE)} pro Nacht für bis zu zehn Gäste. Endreinigung, Bettwäsche, Energie und die Alpbachtal Card mit vier Bergbahnen sind inklusive.`,
  meta: [
    { value: eur(FROM_PRICE), label: 'pro Nacht ab' }, { value: pp(FROM_PRICE), label: 'p. P. & Nacht ab' },
    { value: '10', label: 'Gäste' }, { value: '24 h', label: 'Antwortzeit' },
  ],
  cta: 'Richtpreis berechnen',
  ratesEyebrow: 'Saisonpreise 2026/27', ratesTitle: 'Preis je Nacht für das ganze Haus.',
  ratesText: 'Ein Preis für das Haus, egal ob vier oder zehn Gäste kommen. Die Preise gelten für Aufenthalte bis Dezember 2027.',
  ppTitle: 'Pro Person und Nacht bei zehn Gästen',
  incEyebrow: 'Inklusive', incTitle: 'Alles, was zum Haus gehört.',
  inc: [
    'Das ganze Haus mit 300 m², Garten und Parkplätzen',
    'Endreinigung',
    'Bettwäsche und Handtücher',
    'Strom, Heizung und Brennholz',
    'WLAN im ganzen Haus',
    'Alpbachtal Card für alle Gäste: im Sommer vier Bergbahnen, ganzjährig Regio- und Skibusse',
    'Persönliche Gastgeber, während Ihres Aufenthalts erreichbar',
  ],
  addEyebrow: 'Zusätzlich', addTitle: 'Nur, was Sie wählen.',
  add: [
    [`Ortstaxe`, `${eur2(RULES.touristTax)} pro Person ab 15 Jahren und Nacht`],
    [`Hund`, `${eur(RULES.dogPerNight)} pro Hund und Nacht, maximal zwei`],
    [`Zwei Nächte`, `nur in der Nebensaison, + ${eur(RULES.shortStay.surcharge)} pro Aufenthalt`],
    [`E-Auto laden`, `nach Verbrauch`],
    [`Services`, `Private Chef, Einkaufsservice, Skipässe, Transfer – nach Absprache`],
  ],
  advEyebrow: 'Ihre Vorteile', advTitle: 'Früh buchen, länger bleiben.',
  adv: [
    { n: `${Math.round(RULES.earlyBird.discount * 100)} %`, t: 'Frühbucher', d: `bei Buchung mindestens ${RULES.earlyBird.monthsAhead} Monate vor Anreise` },
    { n: `${Math.round(RULES.longStay.discount * 100)} %`, t: 'Langer Aufenthalt', d: `ab ${RULES.longStay.fromNights} Nächten` },
    { n: '0 %', t: 'Plattformgebühr', d: 'direkt bei den Gastgebern' },
  ],
  advNote: 'Vorteile sind nicht kombinierbar, es gilt der höhere.',
  stepsEyebrow: 'So buchen Sie', stepsTitle: 'Vier Schritte, persönlich begleitet.',
  steps: [
    { t: 'Anfrage senden', d: 'Wunschtermin, Gruppe und Anlass – in zwei Minuten erledigt.' },
    { t: 'Persönliches Angebot', d: 'Innerhalb von 24 Stunden, mit Verfügbarkeit und Endpreis.' },
    { t: 'Anzahlung 30 %', d: 'Per Überweisung – damit ist Ihre Buchung fix.' },
    { t: 'Restzahlung & Anreise', d: 'Rest 30 Tage vor Anreise. Wir empfangen Sie persönlich.' },
  ],
  termsEyebrow: 'Konditionen', termsTitle: 'Klar geregelt.',
  terms: [
    ['Mindestaufenthalt', `Je nach Saison ${SEASONS.low.minNights} bis ${SEASONS.peak.minNights} Nächte, in der Nebensaison auf Anfrage auch zwei.`],
    ['An- und Abreise', 'Anreise zwischen 15 und 20 Uhr, Abreise bis 10 Uhr. Andere Zeiten gerne nach Absprache.'],
    ['Zahlung', 'Anzahlung 30 % bei Buchung, Restzahlung 30 Tage vor Anreise, jeweils per Banküberweisung.'],
    ['Stornierung', 'Bis 60 Tage vor Anreise kostenlos, von 59 bis 30 Tagen 50 %, danach 100 % des Mietpreises. Wir empfehlen eine Reiserücktrittsversicherung.'],
    ['Hunde', `Bis zu zwei Hunde, ${eur(RULES.dogPerNight)} pro Hund und Nacht. Am Haus gibt es einen eingezäunten Bereich.`],
    ['Ortstaxe & Meldung', `${eur2(RULES.touristTax)} pro Person ab 15 Jahren und Nacht für den Tourismusverband Alpbachtal. Wie in Österreich vorgeschrieben, melden wir alle Gäste bei der Anreise an.`],
  ],
  contactEyebrow: 'Lieber persönlich?', contactTitle: 'Rufen Sie uns an.',
  contactText: 'Für Fragen zum Haus, zu Terminen oder besonderen Wünschen sind wir gerne direkt für Sie da.',
} : {
  title: 'Rates & enquiry – farmhouse for 10 guests in the Alpbachtal | Untermoos',
  description: `The whole farmhouse for up to 10 guests from ${eur(FROM_PRICE)} per night – final cleaning, linen, energy, firewood and the Alpbachtal Card included. Seasonal rates, terms and an instant indicative price.`,
  eyebrow: 'Rates & enquiry', heroTitle: 'The whole house. One clear price.',
  leadWinter: `From ${eur(FROM_PRICE)} per night for up to ten guests. Final cleaning, linen, energy, firewood for the tiled stove and the Alpbachtal Card are included.`,
  leadSummer: `From ${eur(FROM_PRICE)} per night for up to ten guests. Final cleaning, linen, energy and the Alpbachtal Card with four mountain lifts are included.`,
  meta: [
    { value: eur(FROM_PRICE), label: 'per night from' }, { value: pp(FROM_PRICE), label: 'per person from' },
    { value: '10', label: 'guests' }, { value: '24 h', label: 'reply time' },
  ],
  cta: 'Calculate your price',
  ratesEyebrow: 'Seasonal rates 2026/27', ratesTitle: 'Price per night for the whole house.',
  ratesText: 'One price for the house, whether four or ten guests come. Rates apply to stays until December 2027.',
  ppTitle: 'Per person per night with ten guests',
  incEyebrow: 'Included', incTitle: 'Everything that comes with the house.',
  inc: [
    'The whole house with 300 m², garden and parking',
    'Final cleaning',
    'Bed linen and towels',
    'Electricity, heating and firewood',
    'Wi-Fi throughout the house',
    'Alpbachtal Card for every guest: four mountain lifts in summer, regional and ski buses all year',
    'Personal hosts, reachable throughout your stay',
  ],
  addEyebrow: 'Extras', addTitle: 'Only what you choose.',
  add: [
    ['Tourist tax', `${eur2(RULES.touristTax)} per person aged 15+ per night`],
    ['Dogs', `${eur(RULES.dogPerNight)} per dog per night, two at most`],
    ['Two nights', `low season only, + ${eur(RULES.shortStay.surcharge)} per stay`],
    ['EV charging', 'billed by use'],
    ['Services', 'private chef, grocery service, ski passes, transfers – by arrangement'],
  ],
  advEyebrow: 'Your benefits', advTitle: 'Book early, stay longer.',
  adv: [
    { n: `${Math.round(RULES.earlyBird.discount * 100)} %`, t: 'Early booking', d: `when you book at least ${RULES.earlyBird.monthsAhead} months ahead` },
    { n: `${Math.round(RULES.longStay.discount * 100)} %`, t: 'Long stay', d: `from ${RULES.longStay.fromNights} nights` },
    { n: '0 %', t: 'Platform fee', d: 'direct with your hosts' },
  ],
  advNote: 'Benefits cannot be combined; the higher one applies.',
  stepsEyebrow: 'How to book', stepsTitle: 'Four steps, personally handled.',
  steps: [
    { t: 'Send an enquiry', d: 'Dates, group and occasion – done in two minutes.' },
    { t: 'Personal offer', d: 'Within 24 hours, with availability and the final price.' },
    { t: '30 % deposit', d: 'By bank transfer – your booking is then confirmed.' },
    { t: 'Balance & arrival', d: 'Balance 30 days before arrival. We welcome you in person.' },
  ],
  termsEyebrow: 'Terms', termsTitle: 'Clearly set out.',
  terms: [
    ['Minimum stay', `${SEASONS.low.minNights} to ${SEASONS.peak.minNights} nights depending on the season; two nights on request in low season.`],
    ['Arrival & departure', 'Check-in between 3 pm and 8 pm, check-out by 10 am. Other times by arrangement.'],
    ['Payment', '30 % deposit on booking, balance 30 days before arrival, both by bank transfer.'],
    ['Cancellation', 'Free of charge up to 60 days before arrival, 50 % from 59 to 30 days, 100 % of the rental price after that. We recommend travel cancellation insurance.'],
    ['Dogs', `Up to two dogs, ${eur(RULES.dogPerNight)} per dog per night. There is a fenced area at the house.`],
    ['Tourist tax & registration', `${eur2(RULES.touristTax)} per person aged 15+ per night for the Alpbachtal tourism board. As required in Austria, we register all guests on arrival.`],
  ],
  contactEyebrow: 'Prefer to talk?', contactTitle: 'Give us a call.',
  contactText: 'For questions about the house, dates or special requests, we are happy to help you directly.',
};

const jsonLd = [
  breadcrumbJsonLd([{ name: 'Untermoos', path: ROUTES.home[lang] }, { name: C.eyebrow, path: ROUTES.rates[lang] }]),
  faqJsonLd(FAQ[lang]),
];
---
<Base lang={lang} route="rates" title={C.title} description={C.description} jsonLd={jsonLd}>
  <Hero lang={lang} compact art eyebrow={C.eyebrow} title={C.heroTitle} leadWinter={C.leadWinter} leadSummer={C.leadSummer} meta={C.meta}>
    <a slot="actions" class="btn btn--light" href="#anfrage">{C.cta} <span class="arrow" aria-hidden="true">↓</span></a>
  </Hero>

  <section class="section rates" aria-labelledby="rates-title">
    <div class="wrap grid">
      <div class="rates__head stack reveal">
        <p class="eyebrow">{C.ratesEyebrow}</p>
        <h2 id="rates-title">{C.ratesTitle}</h2>
        <p class="muted">{C.ratesText}</p>
      </div>
      <div class="rates__table">
        <SeasonTable lang={lang} />
        <div class="pp">
          <p class="footer-label">{C.ppTitle}</p>
          <dl class="pp__list">
            {order.map((k) => (
              <div><dt>{de ? SEASONS[k].deShort : SEASONS[k].enShort}</dt><dd class="num">{pp(SEASONS[k].rate)}</dd></div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight inc" aria-label={`${C.incEyebrow} / ${C.addEyebrow}`}>
    <div class="wrap grid">
      <div class="inc__col stack reveal">
        <p class="eyebrow">{C.incEyebrow}</p>
        <h3>{C.incTitle}</h3>
        <ul class="ticks" role="list">{C.inc.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="add__col stack reveal">
        <p class="eyebrow">{C.addEyebrow}</p>
        <h3>{C.addTitle}</h3>
        <dl class="kv">{C.add.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      </div>
    </div>
  </section>

  <section class="section section--moss adv" aria-labelledby="adv-title">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow adv__eyebrow">{C.advEyebrow}</p>
        <h2 id="adv-title">{C.advTitle}</h2>
      </div>
      <ul class="adv__list" role="list">
        {C.adv.map((a) => (
          <li class="reveal"><span class="adv__n num">{a.n}</span><span class="adv__t">{a.t}</span><span class="adv__d">{a.d}</span></li>
        ))}
      </ul>
      <p class="small adv__note">{C.advNote}</p>
    </div>
  </section>

  <section class="section steps" aria-labelledby="steps-title">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">{C.stepsEyebrow}</p>
        <h2 id="steps-title">{C.stepsTitle}</h2>
      </div>
      <ol class="steps__list" role="list">
        {C.steps.map((s, i) => (
          <li class="reveal"><span class="steps__n num">{String(i + 1).padStart(2, '0')}</span><h3>{s.t}</h3><p class="muted">{s.d}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--tight terms" aria-labelledby="terms-title">
    <div class="wrap grid">
      <div class="terms__head stack">
        <p class="eyebrow">{C.termsEyebrow}</p>
        <h2 id="terms-title">{C.termsTitle}</h2>
      </div>
      <dl class="terms__list">
        {C.terms.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="section enquiry-section">
    <div class="wrap"><Enquiry lang={lang} /></div>
  </section>

  <section class="section section--tight contact" aria-labelledby="contact-title">
    <div class="wrap grid">
      <div class="contact__text stack">
        <p class="eyebrow">{C.contactEyebrow}</p>
        <h2 id="contact-title">{C.contactTitle}</h2>
        <p class="muted measure">{C.contactText}</p>
      </div>
      <div class="contact__lines">
        <a class="contact__big num" href={`tel:${host.phone.replace(/\s/g, '')}`}>{host.phoneDisplay}</a>
        <a class="contact__mail" href={`mailto:${host.email}`}>{host.email}</a>
        <p class="small muted">{host.name} · {de ? 'Gastgeberin' : 'Host'}</p>
      </div>
    </div>
  </section>

  <section class="section faq-section">
    <div class="wrap"><Faq lang={lang} /></div>
  </section>
</Base>

<style>
  .rates__head { grid-column: 1 / span 4; align-self: start; position: sticky; top: 7rem; }
  .rates__table { grid-column: 6 / -1; display: grid; gap: var(--space-l); }
  .pp { display: grid; gap: 0.2rem; }
  .pp .footer-label { color: var(--fels); }
  .pp__list { margin: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); border-top: 1px solid var(--laerche); }
  .pp__list div { display: grid; gap: 0.3rem; padding: 0.9rem 0.8rem 0 0; }
  .pp__list dt { font-size: var(--step--2); letter-spacing: 0.04em; color: var(--fels); line-height: 1.3; }
  .pp__list dd { margin: 0; font-family: var(--font-display); font-size: var(--step-2); line-height: 1; order: -1; }

  .inc { background: var(--papier); }
  .inc__col { grid-column: 1 / span 6; --flow: var(--space-s); }
  .add__col { grid-column: 8 / -1; --flow: var(--space-s); }
  .ticks { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.65rem; }
  .ticks li { position: relative; padding-left: 1.6rem; }
  .ticks li::before { content: ''; position: absolute; left: 0; top: 0.78em; width: 0.8rem; height: 1px; background: var(--geranie); }
  .kv { margin: 0; display: grid; border-top: 1px solid var(--linie); }
  .kv div { display: grid; grid-template-columns: minmax(0, 9rem) minmax(0, 1fr); gap: 1rem; padding: 0.75rem 0; border-bottom: 1px solid var(--linie); }
  .kv dt { font-weight: 600; font-size: var(--step--1); }
  .kv dd { margin: 0; color: var(--fels); font-size: var(--step--1); }

  .adv__eyebrow { color: var(--zirbe); }
  .adv__list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-m); }
  .adv__list li { display: grid; gap: 0.35rem; padding-top: var(--space-s); border-top: 1px solid var(--linie-hell); }
  .adv__n { font-family: var(--font-display); font-size: var(--step-5); font-weight: 300; line-height: 0.9; letter-spacing: -0.03em; }
  .adv__t { font-family: var(--font-display); font-size: var(--step-1); }
  .adv__d { color: rgb(236 238 232 / 0.78); font-size: var(--step--1); }
  .adv__note { margin-top: var(--space-m); color: rgb(236 238 232 / 0.72); }

  .steps__list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-m); counter-reset: s; }
  .steps__list li { display: grid; gap: 0.5rem; align-content: start; padding-top: var(--space-s); border-top: 1px solid var(--laerche); }
  .steps__n { font-size: var(--step--2); font-weight: 600; letter-spacing: 0.16em; color: var(--geranie); }
  .steps__list h3 { font-size: var(--step-1); }

  .terms { background: var(--papier); }
  .terms__head { grid-column: 1 / span 4; align-self: start; }
  .terms__list { grid-column: 6 / -1; margin: 0; border-top: 1px solid var(--linie); }
  .terms__list div { display: grid; grid-template-columns: minmax(0, 14rem) minmax(0, 1fr); gap: var(--space-s); padding: 1.05rem 0; border-bottom: 1px solid var(--linie); }
  .terms__list dt { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.2; }
  .terms__list dd { margin: 0; color: var(--fels); }

  .contact { background: var(--kalk); border-top: 1px solid var(--linie); }
  .contact__text { grid-column: 1 / span 6; --flow: var(--space-xs); }
  .contact__lines { grid-column: 8 / -1; align-self: end; display: grid; gap: 0.4rem; justify-items: start; }
  .contact__big { font-family: var(--font-display); font-size: var(--step-3); line-height: 1; text-decoration: none; font-weight: 320; letter-spacing: -0.01em; }
  .contact__big:hover { color: var(--geranie); }
  .contact__mail { font-size: var(--step-0); }

  .faq-section { padding-top: var(--space-xl); }

  @media (max-width: 980px) {
    .rates__head, .rates__table { grid-column: 1 / -1; position: static; }
    .rates__table { margin-top: var(--space-l); }
    .pp__list { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: var(--space-s); }
    .inc__col, .add__col, .terms__head, .terms__list, .contact__text, .contact__lines { grid-column: 1 / -1; }
    .add__col, .terms__list, .contact__lines { margin-top: var(--space-l); }
    .adv__list { grid-template-columns: 1fr; }
    .steps__list { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--space-l); }
  }
  @media (max-width: 560px) {
    .steps__list { grid-template-columns: 1fr; }
    .terms__list div, .kv div { grid-template-columns: 1fr; gap: 0.25rem; }
  }
</style>
