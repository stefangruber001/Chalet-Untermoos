---
/** Sticky in-page navigation for long pages: chips under the header, the current section is highlighted. */
interface Props { label: string; items: { id: string; label: string; count?: number }[] }
const { label, items } = Astro.props;
---
<nav class="section-nav" aria-label={label} data-section-nav>
  <div class="wrap">
    <ul role="list">
      {items.map((it) => (
        <li><a href={`#${it.id}`} data-chip={it.id}>{it.label}{it.count !== undefined && <span class="num">{it.count}</span>}</a></li>
      ))}
    </ul>
  </div>
</nav>

<script>
  document.querySelectorAll<HTMLElement>('[data-section-nav]').forEach((nav) => {
    const row = nav.querySelector<HTMLElement>('ul')!;
    const chips = new Map([...nav.querySelectorAll<HTMLAnchorElement>('[data-chip]')].map((c) => [c.dataset.chip!, c]));
    const targets = [...chips.keys()].map((id) => document.getElementById(id)).filter((t): t is HTMLElement => Boolean(t));
    if (!('IntersectionObserver' in window) || !targets.length) return;
    const activate = (id: string) => {
      chips.forEach((c, k) => (k === id ? c.setAttribute('aria-current', 'location') : c.removeAttribute('aria-current')));
      const c = chips.get(id);
      // scroll only the chip row – never the page – so a running anchor jump is not interrupted
      if (c) row.scrollTo({ left: c.offsetLeft - row.clientWidth / 2 + c.offsetWidth / 2, behavior: 'smooth' });
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) activate(en.target.id); });
    }, { rootMargin: '-32% 0px -63% 0px' });
    targets.forEach((t) => io.observe(t));
  });
</script>

<style>
  .section-nav {
    position: sticky; top: calc(var(--hdr-h) + var(--safe-top)); z-index: 30;
    background: rgb(249 245 241 / 0.96); backdrop-filter: saturate(140%) blur(12px); -webkit-backdrop-filter: saturate(140%) blur(12px);
    border-bottom: 1px solid var(--line);
    transition: top 0.45s var(--ease);
  }
  /* when the header slides away the bar moves up; its colour fills a phone's top inset */
  :global(html[data-hdr-hide]) .section-nav { top: var(--safe-top); }
  .section-nav::before { content: ''; position: absolute; left: 0; right: 0; bottom: 100%; height: var(--safe-top); background: inherit; }
  .section-nav ul { position: relative; list-style: none; margin: 0; padding: 0.5rem 0; display: flex; gap: 0.45rem; overflow-x: auto; scrollbar-width: none; overscroll-behavior-x: contain; }
  .section-nav ul::-webkit-scrollbar { display: none; }
  /* fade at the right edge hints that more chips scroll into view */
  @media (max-width: 980px) { .section-nav ul { -webkit-mask-image: linear-gradient(90deg, #000 86%, transparent); mask-image: linear-gradient(90deg, #000 86%, transparent); padding-right: 2rem; } }
  .section-nav a {
    display: inline-flex; align-items: center; gap: 0.5rem; white-space: nowrap; text-decoration: none; min-height: 2.5rem;
    font-size: var(--step--1); font-weight: 500; padding: 0.45rem 0.95rem; border: 1px solid var(--line-strong); border-radius: var(--radius);
    transition: background 0.3s var(--ease), color 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .section-nav a span { font-size: var(--step--2); color: var(--ink-2); }
  .section-nav a:hover { border-color: var(--rot); color: var(--rot); }
  .section-nav a[aria-current] { background: var(--rot); color: var(--creme); border-color: var(--rot); }
  .section-nav a[aria-current] span { color: var(--creme-2); }
</style>
