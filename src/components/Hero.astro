---
import Photo from './Photo.astro';
import { getPhoto, type Slot } from '../data/photos';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  eyebrow: string;
  title: string;
  leadWinter: string;
  leadSummer: string;
  meta?: { value: string; label: string }[];
  compact?: boolean;
  winterSlot?: Slot;
  summerSlot?: Slot;
  winterPos?: string;
  summerPos?: string;
  art?: boolean; // force the generative ridge instead of photos
}
const { lang, eyebrow, title, leadWinter, leadSummer, meta = [], compact = false, winterSlot = 'hero-winter', summerSlot = 'hero-summer', winterPos = '62% 50%', summerPos = '60% 45%', art = false } = Astro.props;
const hasPhotos = !art && Boolean(getPhoto(winterSlot) && getPhoto(summerSlot));
const metaColsMobile = meta.length === 4 ? 2 : 3;
---
<section class:list={['hero', { 'hero--compact': compact }]} data-hero>
  <div class="hero__media">
    {hasPhotos ? (
      <>
        <div data-season-only="winter"><Photo slot={winterSlot} lang={lang} ratio="auto" sizes="100vw" high widths={[640, 960, 1440, 1920, 2560]} class="hero__photo" position={winterPos} /></div>
        <div data-season-only="summer"><Photo slot={summerSlot} lang={lang} ratio="auto" sizes="100vw" high widths={[640, 960, 1440, 1920, 2560]} class="hero__photo" position={summerPos} /></div>
      </>
    ) : (
      <canvas class="hero__art" data-ridge aria-hidden="true"></canvas>
    )}
    <div class="hero__shade"></div>
  </div>
  <div class="wrap hero__content">
    <p class="eyebrow hero__eyebrow">{eyebrow}</p>
    <h1 class="hero__title">{title}</h1>
    <p class="hero__lead" data-season-only="winter">{leadWinter}</p>
    <p class="hero__lead" data-season-only="summer">{leadSummer}</p>
    <div class="hero__actions"><slot name="actions" /></div>
    {meta.length > 0 && (
      <dl class="hero__meta" style={`--meta-m:${metaColsMobile}`}>
        {meta.map((m) => (
          <div><dt>{m.label}</dt><dd class="num">{m.value}</dd></div>
        ))}
      </dl>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative; isolation: isolate; color: var(--kalk); background: var(--nacht);
    min-height: min(94svh, 940px); display: flex; align-items: flex-end; overflow: clip;
  }
  .hero--compact { min-height: min(68svh, 640px); }
  .hero__media { position: absolute; inset: 0; z-index: -1; }
  .hero__media > div { position: absolute; inset: 0; }
  .hero__media :global(.hero__photo) { position: absolute; inset: 0; height: 100%; }
  .hero__art { width: 100%; height: 100%; }
  .hero__shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgb(20 22 19 / 0.78) 0%, rgb(20 22 19 / 0.5) 34%, rgb(20 22 19 / 0.08) 62%, rgb(20 22 19 / 0) 100%),
      linear-gradient(180deg, rgb(20 22 19 / 0.35) 0%, rgb(20 22 19 / 0) 22%, rgb(20 22 19 / 0.2) 58%, rgb(20 22 19 / 0.9) 100%);
  }
  .hero__title, .hero__lead, .hero__eyebrow { text-shadow: 0 1px 2px rgb(0 0 0 / 0.3), 0 2px 28px rgb(0 0 0 / 0.32); }
  @media (max-width: 720px) {
    /* Phone: the text block covers the lower two thirds – keep it on a calm, dark ground. */
    .hero__shade { background: linear-gradient(180deg, rgb(20 22 19 / 0.42) 0%, rgb(20 22 19 / 0.16) 20%, rgb(20 22 19 / 0.6) 38%, rgb(20 22 19 / 0.84) 56%, rgb(20 22 19 / 0.95) 100%); }
    .hero__lead { font-weight: 400; }
  }
  .hero__content { padding-block: var(--space-2xl) var(--space-l); display: grid; gap: var(--space-s); }
  .hero__eyebrow { color: var(--zirbe); }
  .hero__title {
    font-size: var(--step-5); font-weight: 300; line-height: 0.86; letter-spacing: -0.035em; margin-left: -0.04em;
  }
  .hero--compact .hero__title { font-size: var(--step-4); line-height: 0.95; letter-spacing: -0.025em; }
  .hero__lead { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.35; max-width: 34ch; font-weight: 320; color: rgb(236 238 232 / 0.92); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: var(--space-2xs); }
  .hero__actions:empty { display: none; }
  .hero__meta {
    display: grid; grid-template-columns: repeat(5, auto); justify-content: start; gap: 0.4rem clamp(1.2rem, 3vw, 3rem);
    margin: var(--space-m) 0 0; padding-top: var(--space-s); border-top: 1px solid var(--linie-hell);
  }
  .hero__meta div { display: grid; gap: 0.15rem; }
  .hero__meta dt { order: 2; font-size: var(--step--2); letter-spacing: 0.14em; text-transform: uppercase; color: var(--fels-hell); font-weight: 600; }
  .hero__meta dd { order: 1; margin: 0; font-family: var(--font-display); font-size: var(--step-2); line-height: 1; font-weight: 340; }
  @media (max-width: 720px) {
    .hero__meta { grid-template-columns: repeat(var(--meta-m, 3), auto); }
  }
  @media (max-width: 380px) {
    .hero__meta { grid-template-columns: repeat(2, auto); }
  }
</style>
