---
import { PLACES, KIND_LABEL } from '../data/places';
import { PROPERTY } from '../data/property';
import type { Lang } from '../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const { lat: lat0, lng: lng0 } = PROPERTY.geo;
const C = 300, R = 262, TMAX = 120;
const radius = (min: number) => R * Math.sqrt(min / TMAX);
const sorted = [...PLACES].sort((a, b) => a.min - b.min);
const dots = sorted.map((p, i) => {
  const dx = (p.lng - lng0) * Math.cos((lat0 * Math.PI) / 180);
  const dy = p.lat - lat0;
  const ang = Math.atan2(dx, dy);
  const r = radius(p.min);
  return { ...p, n: i + 1, x: C + r * Math.sin(ang), y: C - r * Math.cos(ang) };
});
const rings = [15, 30, 60, 90];
const fmtMin = (m: number) => (m < 60 ? `${m} min` : `${Math.floor(m / 60)} h ${String(m % 60).padStart(2, '0')}`);
const aria = lang === 'de'
  ? 'Schematische Karte: Fahrzeiten vom Haus zu Skigebieten, Seen, Städten und Anreisepunkten, nach Himmelsrichtung angeordnet.'
  : 'Schematic map: drive times from the house to ski areas, lakes, towns and arrival points, arranged by compass direction.';
---
<div class="timemap">
  <figure class="timemap__figure">
    <svg viewBox="0 0 600 600" role="img" aria-label={aria}>
      <defs>
        <radialGradient id="tm-fade" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="var(--papier)" stop-opacity="1" />
          <stop offset="100%" stop-color="var(--kalk)" stop-opacity="1" />
        </radialGradient>
      </defs>
      <circle cx={C} cy={C} r={R + 18} fill="url(#tm-fade)" />
      {rings.map((m) => (
        <g>
          <circle cx={C} cy={C} r={radius(m)} fill="none" stroke="var(--linie)" stroke-dasharray={m === 60 ? '0' : '2 5'} />
          <text x={C + 6} y={C - radius(m) - 6} class="tm-ring">{fmtMin(m)}</text>
        </g>
      ))}
      <line x1={C} y1={C - R - 14} x2={C} y2={C - R + 2} stroke="var(--laerche)" />
      <text x={C} y={C - R - 22} text-anchor="middle" class="tm-n">N</text>
      {dots.map((d) => (
        <g class={`tm-dot tm-dot--${d.kind}`}>
          <circle cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r="11" />
          <text x={d.x.toFixed(1)} y={(d.y + 3.8).toFixed(1)} text-anchor="middle">{d.n}</text>
        </g>
      ))}
      <g transform={`translate(${C - 16} ${C - 18})`} fill="none" stroke="var(--geranie)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2.5 13.2 16 5.5l13.5 7.7" />
        <path d="M8 11.2v10.3c0 3.6 2.6 6 8 6s8-2.4 8-6V11.2" />
      </g>
    </svg>
    <figcaption class="small muted">{lang === 'de' ? 'Fahrzeiten mit dem Auto ab dem Haus, gerundet (ca.). Abstand vom Zentrum = Fahrzeit.' : 'Drive times from the house, rounded (approx.). Distance from centre = drive time.'}</figcaption>
  </figure>
  <ol class="timemap__list">
    {dots.map((d) => (
      <li>
        <span class="tm-num num">{d.n}</span>
        <span class="tm-name">{d[lang]}</span>
        <span class="tm-kind">{KIND_LABEL[d.kind][lang]}</span>
        <span class="tm-time num">{fmtMin(d.min)}</span>
      </li>
    ))}
  </ol>
</div>

<style>
  .timemap { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: var(--space-l); align-items: center; }
  .timemap__figure { margin: 0; display: grid; gap: var(--space-xs); }
  .timemap svg { width: 100%; height: auto; max-width: 640px; }
  .tm-ring { font: 600 11px var(--font-text); letter-spacing: 0.12em; fill: var(--fels); text-transform: uppercase; }
  .tm-n { font: 600 12px var(--font-text); fill: var(--laerche); letter-spacing: 0.1em; }
  .tm-dot circle { fill: var(--laerche); }
  .tm-dot--travel circle { fill: var(--geranie); }
  .tm-dot--lake circle, .tm-dot--nature circle { fill: var(--moos); }
  .tm-dot--ski circle { fill: var(--schiefer); }
  .tm-dot text { font: 600 11px var(--font-text); fill: var(--kalk); }
  .timemap__list { list-style: none; margin: 0; padding: 0; display: grid; }
  .timemap__list li {
    display: grid; grid-template-columns: 2rem minmax(0, 1fr) auto 4.6rem; align-items: baseline; gap: 0.75rem;
    padding: 0.62rem 0; border-bottom: 1px solid var(--linie);
  }
  .tm-num { font-size: var(--step--1); font-weight: 600; color: var(--fels); }
  .tm-name { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.2; min-width: 0; }
  .tm-kind { font-size: var(--step--2); letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; color: var(--fels); }
  .tm-time { text-align: right; font-weight: 600; font-size: var(--step--1); }
  @media (max-width: 900px) { .timemap { grid-template-columns: 1fr; } }
</style>
