---
import { PLACES, KIND_LABEL } from '../data/places';
import { PROPERTY } from '../data/property';
import type { Lang } from '../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const { lat: lat0, lng: lng0 } = PROPERTY.geo;
const C = 300, R = 262, TMAX = 120;
const radius = (min: number) => R * Math.sqrt(min / TMAX);
const sorted = [...PLACES].sort((a, b) => a.min - b.min);
const dots = sorted.map((p, i) => {
  const dx = (p.lng - lng0) * Math.cos((lat0 * Math.PI) / 180);
  const dy = p.lat - lat0;
  const ang = Math.atan2(dx, dy);
  const r = radius(p.min);
  return { ...p, n: i + 1, x: C + r * Math.sin(ang), y: C - r * Math.cos(ang) };
});
const rings = [15, 30, 60, 90];
const fmtMin = (m: number) => (m < 60 ? `${m} min` : `${Math.floor(m / 60)} h ${String(m % 60).padStart(2, '0')}`);
const aria = lang === 'de'
  ? 'Schematische Karte: Fahrzeiten vom Haus zu Skigebieten, Seen, Städten und Anreisepunkten, nach Himmelsrichtung angeordnet.'
  : 'Schematic map: drive times from the house to ski areas, lakes, towns and arrival points, arranged by compass direction.';
---
<div class="timemap" data-timemap>
  <figure class="timemap__figure">
    <svg viewBox="0 0 600 600" role="img" aria-label={aria}>
      <defs>
        <radialGradient id="tm-fade" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="var(--rose-1)" stop-opacity="1" />
          <stop offset="100%" stop-color="var(--paper)" stop-opacity="1" />
        </radialGradient>
      </defs>
      <circle cx={C} cy={C} r={R + 18} fill="url(#tm-fade)" />
      {rings.map((m) => (
        <g>
          <circle cx={C} cy={C} r={radius(m)} fill="none" stroke="var(--line-strong)" stroke-dasharray={m === 60 ? '0' : '2 5'} />
          <text x={C + 6} y={C - radius(m) - 7} class="tm-ring">{fmtMin(m)}</text>
        </g>
      ))}
      <line x1={C} y1={C - R - 14} x2={C} y2={C - R + 2} stroke="var(--ink)" />
      <text x={C} y={C - R - 22} text-anchor="middle" class="tm-n">N</text>
      {dots.map((d) => (
        <g class="tm-dot" data-tm-dot={d.n}>
          <circle cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r="12" />
          <text x={d.x.toFixed(1)} y={(d.y + 4.2).toFixed(1)} text-anchor="middle">{d.n}</text>
        </g>
      ))}
      <circle cx={C} cy={C} r="22" fill="var(--rot)" />
      <use href="#um-stag" x={C - 13} y={C - 15.5} width="26" height="30" fill="var(--creme)" />
    </svg>
    <figcaption class="small muted">{lang === 'de' ? 'Abstand vom Haus in der Mitte = Fahrzeit, Richtung wie auf der Landkarte.' : 'Distance from the house in the centre = drive time, direction as on a map.'}</figcaption>
  </figure>
  <div class="timemap__side">
    <ol class="timemap__list">
      {dots.map((d) => (
        <li data-tm={d.n} style={`--t:${Math.min(1, d.min / 105).toFixed(3)}`} tabindex="0">
          <span class="tm-badge num" aria-hidden="true">{d.n}</span>
          <span class="tm-name">{d[lang]} <span class="tm-kind">{KIND_LABEL[d.kind][lang]}</span></span>
          <span class="tm-time num">{fmtMin(d.min)}</span>
        </li>
      ))}
    </ol>
    <p class="small muted">{lang === 'de' ? 'Fahrzeiten mit dem Auto ab dem Haus, gerundet (ca.). Der Balken unter jedem Ziel zeigt die Fahrzeit.' : 'Drive times by car from the house, rounded (approx.). The bar under each place shows the drive time.'}</p>
  </div>
</div>

<script>
  // Hover or focus a place in the list (or a dot on the map) to highlight its partner.
  document.querySelectorAll<HTMLElement>('[data-timemap]').forEach((root) => {
    const set = (n: string | null) => {
      root.querySelectorAll<SVGGElement>('[data-tm-dot]').forEach((g) => g.classList.toggle('is-on', g.dataset.tmDot === n));
      root.querySelectorAll<HTMLElement>('[data-tm]').forEach((li) => li.classList.toggle('is-on', li.dataset.tm === n));
      root.classList.toggle('has-focus', n !== null);
    };
    root.querySelectorAll<HTMLElement>('[data-tm]').forEach((li) => {
      li.addEventListener('mouseenter', () => set(li.dataset.tm!));
      li.addEventListener('focus', () => set(li.dataset.tm!));
      li.addEventListener('mouseleave', () => set(null));
      li.addEventListener('blur', () => set(null));
    });
    root.querySelectorAll<SVGGElement>('[data-tm-dot]').forEach((g) => {
      g.addEventListener('mouseenter', () => set(g.dataset.tmDot!));
      g.addEventListener('mouseleave', () => set(null));
    });
  });
</script>

<style>
  .timemap { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: var(--space-l); align-items: center; }
  .timemap__figure { margin: 0; display: grid; gap: var(--space-xs); }
  .timemap svg { width: 100%; height: auto; max-width: 640px; }
  .tm-ring { font: 600 13px var(--font-text); letter-spacing: 0.1em; fill: var(--ink-2); text-transform: uppercase; }
  .tm-n { font: 600 13px var(--font-text); fill: var(--ink); letter-spacing: 0.1em; }
  .tm-dot circle { fill: var(--rot); transition: r 0.25s var(--ease), opacity 0.25s var(--ease); }
  .tm-dot text { font: 700 12px var(--font-text); fill: var(--creme); pointer-events: none; }
  .tm-dot { cursor: default; transition: opacity 0.25s var(--ease); }
  .has-focus .tm-dot:not(.is-on) { opacity: 0.28; }
  .tm-dot.is-on circle { r: 16px; fill: var(--rot-tief); }
  .timemap__side { display: grid; gap: var(--space-s); min-width: 0; }
  .timemap__list { list-style: none; margin: 0; padding: 0; display: grid; }
  .timemap__list li {
    position: relative; display: grid; grid-template-columns: 1.9rem minmax(0, 1fr) auto; align-items: center; gap: 0.8rem;
    padding: 0.7rem 0 0.8rem; border-bottom: 1px solid var(--line); outline-offset: 2px;
  }
  /* time bar along the row's base line: length = drive time */
  .timemap__list li::after { content: ''; position: absolute; left: 2.7rem; bottom: -1px; height: 2px; width: calc((100% - 2.7rem) * var(--t)); background: var(--rot); opacity: 0.6; }
  .timemap__list li.is-on { background: var(--rose-1); }
  .tm-badge { width: 1.75rem; height: 1.75rem; border-radius: 50%; background: var(--rot); color: var(--creme); display: grid; place-items: center; font-size: 0.8rem; font-weight: 700; }
  .tm-name { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.2; min-width: 0; }
  .tm-kind { display: block; margin-top: 0.15rem; font-family: var(--font-text); font-size: var(--step--2); letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; color: var(--ink-2); }
  .tm-time { text-align: right; font-weight: 600; font-size: var(--step--1); white-space: nowrap; }
  @media (max-width: 900px) { .timemap { grid-template-columns: 1fr; } }
  /* phones: the list with time bars carries the information; the radial map would be too small to read */
  @media (max-width: 560px) { .timemap__figure { display: none; } }
</style>
