---
import Crest from './Crest.astro';
import { NAV, ROUTES, url, type Lang, type RouteKey } from '../i18n/routes';
import { UI } from '../i18n/ui';
import { PROPERTY } from '../data/property';

interface Props { lang: Lang; route: RouteKey }
const { lang, route } = Astro.props;
const t = UI[lang];
const other: Lang = lang === 'de' ? 'en' : 'de';
const switchHref = ROUTES[route][other];
const host = PROPERTY.host;
---
<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href={url('home', lang)} aria-label="Untermoos – Start">
      <Crest />
      <span class="brand__text"><span class="brand__word">Untermoos</span><span class="brand__tag">{t.brandTag}</span></span>
    </a>
    <nav class="nav" aria-label={lang === 'de' ? 'Hauptnavigation' : 'Main navigation'}>
      {NAV.map((key) => (
        <a href={url(key, lang)} aria-current={route === key ? 'page' : undefined}>{t.nav[key as keyof typeof t.nav]}</a>
      ))}
    </nav>
    <div class="header-tools">
      <div class="season-toggle" role="group" aria-label={t.season.label}>
        <button type="button" data-season-set="winter" aria-pressed="false">{t.season.winter}</button>
        <button type="button" data-season-set="summer" aria-pressed="false">{t.season.summer}</button>
      </div>
      <a class="lang" href={switchHref} hreflang={other} lang={other} title={t.langSwitch.label}>{t.langSwitch.short}</a>
      <a class="btn header-cta" href={url('rates', lang, 'anfrage')}>{t.enquire}</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu-sheet" data-menu-open>
        <span class="menu-btn__lines" aria-hidden="true"><i></i><i></i><i></i></span>{t.menu}
      </button>
    </div>
  </div>
</header>

<div class="menu-sheet" id="menu-sheet" hidden data-menu role="dialog" aria-modal="true" aria-label={t.menu}>
  <div class="menu-sheet__top">
    <a class="brand" href={url('home', lang)} aria-label="Untermoos – Start">
      <Crest />
      <span class="brand__text"><span class="brand__word">Untermoos</span><span class="brand__tag">{t.brandTag}</span></span>
    </a>
    <button class="menu-close" type="button" data-menu-close>{t.close}</button>
  </div>
  <nav aria-label={lang === 'de' ? 'Mobile Navigation' : 'Mobile navigation'}>
    <a href={url('home', lang)} aria-current={route === 'home' ? 'page' : undefined}>Start</a>
    {NAV.map((key) => (
      <a href={url(key, lang)} aria-current={route === key ? 'page' : undefined}>{t.nav[key as keyof typeof t.nav]}</a>
    ))}
  </nav>
  <div class="menu-sheet__foot">
    <a class="btn btn--light" href={url('rates', lang, 'anfrage')}>{t.enquireLong} <span class="arrow" aria-hidden="true">→</span></a>
    <div class="menu-sheet__contact">
      <span>{t.footer.contact} · {t.footer.reply}</span>
      <a href={`tel:${host.phone.replace(/\s/g, '')}`} class="num">{host.phoneDisplay}</a>
      <a href={`mailto:${host.email}`}>{host.email}</a>
    </div>
    <div class="menu-sheet__row">
      <div class="season-toggle" role="group" aria-label={t.season.label}>
        <button type="button" data-season-set="winter" aria-pressed="false">{t.season.winter}</button>
        <button type="button" data-season-set="summer" aria-pressed="false">{t.season.summer}</button>
      </div>
      <a class="lang" href={switchHref} hreflang={other} lang={other}>{t.langSwitch.label}</a>
    </div>
  </div>
</div>
