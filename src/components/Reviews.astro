---
import type { Lang } from '../i18n/routes';
import { REVIEWS, SHOW_SAMPLES } from '../data/reviews';

interface Props { lang: Lang }
const { lang } = Astro.props;
const C = lang === 'de'
  ? { eyebrow: 'Gästestimmen', title: 'Was Gäste erzählen.', stars: (n: number) => `${n} von 5 Sternen`, sample: 'Beispiel',
      note: 'Beispieltexte für die Vorschau – vor dem Livegang durch echte Gästebewertungen ersetzt.' }
  : { eyebrow: 'Guest reviews', title: 'What guests say.', stars: (n: number) => `${n} out of 5 stars`, sample: 'Sample',
      note: 'Sample texts for this preview – replaced by real guest reviews before launch.' };
const items = REVIEWS.filter((r) => !r.sample || SHOW_SAMPLES);
const STAR = 'M10 1.6l2.47 5.01 5.53.8-4 3.9.94 5.5L10 14.2l-4.94 2.6.94-5.5-4-3.9 5.53-.8z';
---
{items.length > 0 && (
  <section class="section section--rose reviews" aria-labelledby="reviews-title">
    <div class="wrap">
      <div class="head reveal">
        <p class="eyebrow">{C.eyebrow}</p>
        <h2 id="reviews-title">{C.title}</h2>
      </div>
      <div class="reviews__grid">
        {items.map((r) => (
          <figure class="review reveal">
            <div class="review__top">
              <span class="review__stars" role="img" aria-label={C.stars(r.stars)}>
                {Array.from({ length: 5 }, (_, i) => <svg viewBox="0 0 20 20" aria-hidden="true" class={i < r.stars ? 'on' : undefined}><path d={STAR} /></svg>)}
              </span>
              {r.sample && <span class="review__tag">{C.sample}</span>}
            </div>
            <blockquote><p>{r[lang].text}</p></blockquote>
            <figcaption>{r[lang].who}</figcaption>
          </figure>
        ))}
      </div>
      {items.some((r) => r.sample) && <p class="reviews__note">{C.note}</p>}
    </div>
  </section>
)}

<style>
  .reviews__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.75rem); }
  .review { margin: 0; background: var(--paper); padding: clamp(1.35rem, 2.4vw, 2.1rem); display: grid; grid-template-rows: auto 1fr auto; gap: var(--space-s); }
  .review__top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .review__stars { display: inline-flex; gap: 0.18rem; color: var(--rose-3); }
  .review__stars svg { width: 1.1rem; height: 1.1rem; fill: currentColor; }
  .review__stars svg.on { color: var(--rot); }
  .review__tag { font-size: var(--step--2); font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-2); border: 1px solid var(--rose-3); padding: 0.2rem 0.55rem; line-height: 1.3; }
  .review blockquote { margin: 0; quotes: '\201E' '\201C'; }
  :global(:lang(en)) .review blockquote { quotes: '\201C' '\201D'; }
  .review blockquote p { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.42; text-wrap: pretty; }
  .review blockquote p::before { content: open-quote; }
  .review blockquote p::after { content: close-quote; }
  .review figcaption { font-size: var(--step--1); font-weight: 600; color: var(--ink-2); padding-top: var(--space-s); border-top: 1px solid var(--rose-3); }
  .reviews__note { margin-top: var(--space-m); font-size: var(--step--1); color: var(--ink-2); }
  @media (max-width: 900px) {
    .reviews__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .review:nth-child(3):last-child { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) {
    .reviews__grid { grid-template-columns: 1fr; }
  }
</style>
