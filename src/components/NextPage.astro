---
/** "Weiter" – leads to the next page of the site's natural sequence (house → photos → region → occasions → rates). */
import Photo from './Photo.astro';
import { url, type Lang, type RouteKey } from '../i18n/routes';
import { UI } from '../i18n/ui';
import type { Slot } from '../data/photos';

interface Props { lang: Lang; to: RouteKey; text: string; photo: Slot; position?: string } // not `slot`: Astro reserves it
const { lang, to, text, photo, position } = Astro.props;
const label = UI[lang].nav[to as keyof (typeof UI)[typeof lang]['nav']];
---
<a class="next-page" href={url(to, lang)}>
  <div class="wrap next-page__inner">
    <div class="next-page__text">
      <span class="eyebrow">{lang === 'de' ? 'Weiter' : 'Next'}</span>
      <span class="next-page__title">{label} <span class="arrow" aria-hidden="true">→</span></span>
      <span class="next-page__lead">{text}</span>
    </div>
    <div class="next-page__media" aria-hidden="true">
      <Photo slot={photo} lang={lang} ratio="4/3" sizes="(min-width: 860px) 26vw, 1px" widths={[480, 768]} position={position} alt="" />
    </div>
  </div>
</a>

<style>
  .next-page { display: block; color: inherit; text-decoration: none; background: var(--papier); border-top: 1px solid var(--linie); transition: background 0.4s var(--ease); }
  .next-page:hover { background: var(--kalk); }
  .next-page__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.42fr); gap: var(--space-l); align-items: center; padding-block: var(--space-xl); }
  .next-page__text { display: grid; gap: var(--space-xs); justify-items: start; }
  .next-page__title { font-family: var(--font-display); font-size: var(--step-4); font-weight: 300; line-height: 0.95; letter-spacing: -0.025em; display: inline-flex; align-items: baseline; gap: 0.35em; }
  .next-page__title .arrow { font-size: 0.55em; transition: transform 0.45s var(--ease); }
  .next-page:hover .next-page__title .arrow { transform: translateX(8px); }
  .next-page:hover .next-page__title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.12em; text-decoration-color: var(--geranie); }
  .next-page__lead { color: var(--fels); max-width: 46ch; }
  @media (max-width: 720px) {
    .next-page__inner { grid-template-columns: 1fr; padding-block: var(--space-l); }
    .next-page__media { display: none; }
  }
</style>
