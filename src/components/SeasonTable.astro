---
import { SEASONS, SEASON_TABLE } from '../data/rates';
import { fmtEUR } from '../i18n/ui';
import type { Lang } from '../i18n/routes';

interface Props { lang: Lang; compact?: boolean }
const { lang, compact = false } = Astro.props;
const de = lang === 'de';
const order = ['festive', 'peak', 'winter', 'summer', 'shoulder', 'low'] as const;
---
{compact ? (
  <dl class="season-compact">
    {order.map((k) => (
      <div>
        <dt>{SEASONS[k][lang]}</dt>
        <dd class="num">{fmtEUR(SEASONS[k].rate, lang)}</dd>
      </div>
    ))}
  </dl>
) : (
  <div class="table-wrap">
    <table class="season-table">
      <caption class="sr-only">{de ? 'Preise je Nacht für das ganze Haus nach Saison' : 'Rates per night for the whole house by season'}</caption>
      <thead>
        <tr>
          <th scope="col">{de ? 'Zeitraum' : 'Period'}</th>
          <th scope="col">{de ? 'Saison' : 'Season'}</th>
          <th scope="col" class="r">{de ? 'Mindestaufenthalt' : 'Minimum stay'}</th>
          <th scope="col" class="r">{de ? 'Ganzes Haus / Nacht' : 'Whole house / night'}</th>
        </tr>
      </thead>
      <tbody>
        {SEASON_TABLE.map((row) => {
          const s = SEASONS[row.season];
          return (
            <tr data-season-row={row.season}>
              <td>{row[lang]}</td>
              <td>{de ? s.deShort : s.enShort}</td>
              <td class="r num">{s.minNights} {de ? 'Nächte' : 'nights'}</td>
              <td class="r num price">{fmtEUR(s.rate, lang)}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
)}

<style>
  .season-compact { display: grid; margin: 0; }
  .season-compact { border-top: 1px solid var(--ink); }
  .season-compact div { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: 0.75rem 0; border-bottom: 1px solid var(--line-strong); }
  .season-compact dt { color: var(--ink-2); font-size: var(--step--1); }
  .season-compact dd { margin: 0; font-family: var(--font-display); font-weight: 460; color: var(--rot); font-size: var(--step-1); line-height: 1; }
  .table-wrap { overflow-x: auto; container-type: inline-size; }
  .season-table { width: 100%; border-collapse: collapse; font-size: var(--step--1); min-width: 560px; }
  .season-table th { text-align: left; font-size: var(--step--2); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-2); font-weight: 600; padding: 0 0.8rem 0.8rem 0; border-bottom: 1px solid var(--ink); }
  .season-table td { padding: 0.95rem 0.8rem 0.95rem 0; border-bottom: 1px solid var(--line); vertical-align: baseline; }
  .season-table .r { text-align: right; }
  .season-table .price { font-family: var(--font-display); font-weight: 460; color: var(--rot); font-size: var(--step-1); }
  @container (max-width: 600px) {
    /* Narrow column (phones, stacked tablet layouts): one compact row per period – dates and price on top, season and minimum stay below. No sideways scrolling. */
    .table-wrap { overflow: visible; }
    .season-table { min-width: 0; border-top: 1px solid var(--ink); }
    .season-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .season-table tbody, .season-table tr { display: block; }
    .season-table tr { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; column-gap: 0.5rem; row-gap: 0.15rem; padding: 0.85rem 0; border-bottom: 1px solid var(--line); }
    .season-table td { padding: 0; border: 0; }
    .season-table td:nth-child(1) { grid-column: 1 / 3; grid-row: 1; font-weight: 600; }
    .season-table td:nth-child(2) { grid-column: 1; grid-row: 2; color: var(--ink-2); }
    .season-table td:nth-child(3) { grid-column: 2; grid-row: 2; text-align: left; color: var(--ink-2); }
    .season-table td:nth-child(3)::before { content: '· '; }
    .season-table td.price { grid-column: 3; grid-row: 1 / 3; align-self: center; font-size: var(--step-2); }
  }
</style>
