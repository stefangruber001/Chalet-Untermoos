---
import { url, type Lang } from '../i18n/routes';

interface Props { lang: Lang; title?: string; text?: string }
const { lang } = Astro.props;
const de = lang === 'de';
const title = Astro.props.title ?? (de ? 'Ihr Zeitraum ist frei?' : 'Are your dates free?');
const text = Astro.props.text ?? (de ? 'Fragen Sie an – wir antworten innerhalb von 24 Stunden mit einem persönlichen Angebot.' : 'Send an enquiry – we reply within 24 hours with a personal offer.');
---
<section class="cta-band" aria-labelledby="cta-title">
  <canvas class="cta-band__art" data-ridge aria-hidden="true"></canvas>
  <div class="wrap cta-band__inner">
    <h2 id="cta-title">{title}</h2>
    <p class="lead lead--s">{text}</p>
    <div><a class="btn btn--light" href={url('rates', lang, 'anfrage')}>{de ? 'Verfügbarkeit anfragen' : 'Check availability'} <span class="arrow" aria-hidden="true">→</span></a></div>
  </div>
</section>

<style>
  .cta-band { position: relative; isolation: isolate; background: var(--nacht); color: var(--kalk); overflow: clip; }
  .cta-band__art { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; opacity: 0.9; }
  .cta-band::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgb(24 27 23 / 0.75), rgb(24 27 23 / 0.2) 60%, rgb(24 27 23 / 0.6)); }
  .cta-band__inner { padding-block: var(--space-2xl); display: grid; gap: var(--space-s); justify-items: start; }
  .cta-band h2 { font-size: var(--step-4); max-width: 14ch; }
  .cta-band p { max-width: 40ch; color: rgb(236 238 232 / 0.9); }
</style>
